# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- PostgreSQL ---
POSTGRES_USER=cloudcost
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudcost
# Used by the backend to connect (host is the docker-compose service name)
DATABASE_URL=postgresql+psycopg://cloudcost:change-me@postgres:5432/cloudcost

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Secrets encryption ---
# Encrypts AWS/OCI credentials at rest in Postgres. Generate once and keep it like any
# other permanent secret (losing it makes stored credentials unrecoverable):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# AWS and Oracle Cloud (OCI) credentials are no longer configured here — set them up
# from the dashboard's Settings page (/settings) after the backend starts.
