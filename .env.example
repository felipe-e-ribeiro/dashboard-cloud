# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- PostgreSQL ---
POSTGRES_USER=cloudcost
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudcost
# Used by the backend to connect (host is the docker-compose service name)
DATABASE_URL=postgresql+psycopg://cloudcost:change-me@postgres:5432/cloudcost

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- AWS (read-only Cost Explorer access) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Oracle Cloud (OCI) ---
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_REGION=
# Path INSIDE the backend container where the PEM private key is mounted
# (mount ./secrets/oci_key.pem from the host — see docker-compose.yml)
OCI_KEY_FILE_PATH=/run/secrets/oci_key.pem
